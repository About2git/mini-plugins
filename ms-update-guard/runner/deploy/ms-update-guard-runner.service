[Unit]
Description=MS Update Guard test runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=msug-runner
WorkingDirectory=/opt/ms-update-guard-runner
EnvironmentFile=/etc/ms-update-guard-runner.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/ms-update-guard-runner/state /opt/ms-update-guard-runner/artifacts
PrivateTmp=true

[Install]
WantedBy=multi-user.target
