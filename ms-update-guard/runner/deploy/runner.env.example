# /etc/ms-update-guard-runner.env  (chmod 600, owner root)
MSUG_RUNNER_CONFIG=/opt/ms-update-guard-runner/config/runner.local.json
# Accepted keys per key id; list the previous key during rotation: "k2:NEW,k1:OLD"
MSUG_TRIGGER_KEYS=k1:replace-with-at-least-32-random-characters-aaaa
MSUG_STATUS_KEYS=k1:replace-with-another-32-random-characters-bbbb
MSUG_CALLBACK_SECRET=replace-with-a-third-32-random-characters-cccc
# Optional: browser binary if not installed via `npx playwright-core install chromium`
# MSUG_CHROMIUM_PATH=/usr/bin/chromium
# Test accounts for protected pages (referenced by name in the site config, never logged)
# SITE51_USER=msug-test
# SITE51_PASS=...
